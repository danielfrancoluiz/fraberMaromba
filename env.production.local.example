NEXT_PUBLIC_SUPABASE_URL=https://zdtqfvvlqpwoiigbuikl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Session pooler (5432) — Settings → Database → Connection string → Session mode
DIRECT_URL=postgresql://postgres.zdtqfvvlqpwoiigbuikl:[SENHA]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Transaction pooler (6543) — Runtime na Vercel
DATABASE_URL=postgresql://postgres.zdtqfvvlqpwoiigbuikl:[SENHA]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

NEXTAUTH_URL=https://www.fraber360.com.br
NEXTAUTH_SECRET=

